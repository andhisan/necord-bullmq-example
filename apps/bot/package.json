{
	"name": "bot",
	"private": true,
	"scripts": {
		"build": "nest build",
		"start": "nest start",
		"dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@nestjs/bullmq": "^11.0.4",
		"@nestjs/cli": "^11.0.7",
		"@nestjs/common": "^11.0.1",
		"@nestjs/core": "^11.0.1",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/swagger": "^11.2.0",
		"bullmq": "^5.61.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"discord.js": "^14.21.0",
		"dotenv": "^17.2.3",
		"necord": "^6.9.1",
		"nest-commander": "^3.18.0",
		"nest-typed-config": "^2.10.1",
		"nest-winston": "^1.10.2",
		"nestjs-spelunker": "^1.3.2",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"winston": "^3.17.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@swc/cli": "^0.6.0",
		"@swc/core": "^1.10.7",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.7",
		"@types/supertest": "^6.0.2",
		"globals": "^16.0.0",
		"jest": "^29.7.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3"
	},
	"engines": {
		"node": "^22"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"moduleNameMapper": {
			"@/(.*)$": "<rootDir>/$1"
		},
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node",
		"setupFiles": [
			"<rootDir>/frameworks/jest/jest-setup.ts"
		]
	}
}
